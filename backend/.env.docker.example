# Variables del contenedor. Copiar a .env.docker (no se sube al repositorio) y completar.
TZ=America/Caracas

# Misma base de datos "intranet" que usa intranet-api-auth, con el esquema propio "eventos".
# Host y puerto: copiarlos de SCHEMA_API_AUTH (intranet-api-auth/.env). Usuario y clave: un rol propio con permisos
# solo sobre el esquema eventos. Prueba local con Postgres en tu PC: host.docker.internal en vez de localhost.
DATABASE_URL="postgresql://usuario:clave@host.docker.internal:5432/intranet?schema=eventos"

# El MISMO valor que SERVICES_SECRET_KEY en intranet-api-auth/.env
SERVICES_SECRET_KEY=cambiar
